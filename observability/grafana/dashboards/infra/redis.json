    {
      "type": "timeseries",
      "title": "Hit ratio: Redis vs the app",
      "description": "Redis counts key reads; the app counts logical lookups per cache family (a family can read several keys, and a stale hit refreshes in the background). Both last 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "redis:hit_ratio:5m",
          "legendFormat": "Redis keyspace",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "(sum(cache:requests:rate5m{app_cache_result=\"hit\"}) or vector(0)) / sum(cache:requests:rate5m)",
          "legendFormat": "app (all families)",
          "refId": "B",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "cache:hit_ratio",
          "legendFormat": "app: {{app_cache_name}}",
          "refId": "C",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "max": 1,
          "min": 0
