    {
      "type": "timeseries",
      "title": "Lookups / min by result",
      "description": "miss = the loader ran (Warcraft Logs or another source), error = a corrupt entry or a failed load.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (app_cache_result) (cache:requests:rate5m) * 60",
          "legendFormat": "{{app_cache_result}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
