    },
    {
      "type": "table",
      "title": "Lookups in range by family",
      "description": "WCL cache lookups per family over the dashboard range.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "round(sum by (app_cache_name) (increase(app_cache_requests{service_namespace=\"wcl-agent\"}[$__range])))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
