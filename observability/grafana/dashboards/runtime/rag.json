      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "rag:retrieved_chunks:avg5m",
          "legendFormat": "{{app_rag_index}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
