{
  "uid": "wcl-d5-frontend",
  "title": "App: Frontend",
  "description": "D5 (feature 060): Web Vitals, browser errors and chat moments from Faro, queried from Loki directly (no ruler). Route = the React Router template Faro reports as its view.",
  "tags": [
    "wcl-agent",
    "runtime"
  ],
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "wcl-agent"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Sessions",
      "description": "Faro sessions started in the range (session_start events; the session id itself is masked).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"web\"} |= \"session_start\" | logfmt | kind=\"event\" | event_name=\"session_start\" [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 1
    },
