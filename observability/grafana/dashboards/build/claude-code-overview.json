{
  "uid": "wcl-cc-overview",
  "title": "Claude Code: Overview",
  "description": "D1: cost, tokens, cache efficiency and output of the agent team (build layer), from bin/claude-otel sessions. Every panel queries the cc:* recording rules (observability/mimir/rules/anonymous/build.yaml). Cost is Claude Code's estimate at list price.",
  "tags": [
    "wcl-agent",
    "build"
  ],
  "editable": true,
  "schemaVersion": 41,
  "version": 2,
  "refresh": "1m",
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Sprint ends",
        "enable": true,
        "iconColor": "rgba(255, 152, 48, 0.9)",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "expr": "max by (sprint) (team_sprint_points)",
        "step": "60s",
        "titleFormat": "Sprint {{sprint}} ends",
        "textFormat": "{{sprint}}: see Agent Team: Improvement",
        "tagKeys": "sprint",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Spend (estimated, list price)",
      "description": "Claude Code's own cost estimate at API list prices. On a Max plan this is the list-price equivalent, not what you are billed. Whole selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum (sum_over_time(cc:cost_usd:rate5m{service_namespace=\"wcl-agent\"}[$__range])) * 60",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "noValue": "0",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Spend per hour (estimated, list price)",
      "description": "Claude Code's own cost estimate at API list prices. On a Max plan this is the list-price equivalent, not what you are billed. Average over the last hour.",
