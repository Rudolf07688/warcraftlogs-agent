      "interval": "5m",
      "id": 14,
      "type": "timeseries",
      "title": "Spend by agent (estimated, list price)",
      "description": "Estimated spend per time bucket by Claude Code agent type (agent.name). Every developer is 'developer'; per seat see Claude Code: Agent Team.",
