{
  "uid": "wcl-cc-overview",
  "title": "Claude Code: Overview",
  "description": "Cost and tokens of the agent team (build layer), from bin/claude-otel sessions. Starter version of D1; the full D1/D2 come in the next telemetry sprint.",
  "tags": [
    "wcl-agent",
    "build"
  ],
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Sprint ends",
        "enable": true,
        "iconColor": "rgba(255, 152, 48, 0.9)",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "expr": "max by (sprint) (team_sprint_points)",
        "step": "60s",
        "titleFormat": "Sprint {{sprint}} ends",
        "textFormat": "{{sprint}}: see Agent Team: Improvement",
        "tagKeys": "sprint",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Spend (estimate)",
      "description": "Claude Code's own cost estimate over the selected time range. On a Max plan this is list-price equivalent, not what you are billed.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(increase(claude_code_cost_usage{service_namespace=\"wcl-agent\", service_name=\"claude-code\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "noValue": "0",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tokens",
      "description": "All token types together: input, output, cache read and cache write.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(increase(claude_code_token_usage{service_namespace=\"wcl-agent\", service_name=\"claude-code\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache read share",
      "description": "Share of tokens served from the prompt cache. Higher is cheaper (cache reads cost 0.1x).",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(increase(claude_code_token_usage{service_name=\"claude-code\", type=\"cacheRead\"}[$__range])) / sum(increase(claude_code_token_usage{service_namespace=\"wcl-agent\", service_name=\"claude-code\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Output tokens",
      "description": "Tokens the model wrote (the most expensive type, 5x input).",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(increase(claude_code_token_usage{service_name=\"claude-code\", type=\"output\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Sessions",
      "description": "Claude Code sessions started through bin/claude-otel (approximate: increase() extrapolates).",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(increase(claude_code_session_count{service_namespace=\"wcl-agent\", service_name=\"claude-code\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Active time",
      "description": "Time spent actively working (typing or model running).",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(increase(claude_code_active_time_total{service_namespace=\"wcl-agent\", service_name=\"claude-code\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "maxDataPoints": 100,
      "interval": "5m",
      "id": 7,
      "type": "timeseries",
      "title": "Spend by model",
      "description": "Estimated spend per time bucket, stacked by model.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (model) (increase(claude_code_cost_usage{service_namespace=\"wcl-agent\", service_name=\"claude-code\"}[$__interval]))",
          "legendFormat": "{{model}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": 300000,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "maxDataPoints": 100,
      "interval": "5m",
      "id": 8,
      "type": "timeseries",
      "title": "Spend by agent",
      "description": "Estimated spend per agent. 'main session' is the top-level session; others are subagents by name.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "label_replace(sum by (agent_name) (increase(claude_code_cost_usage{service_namespace=\"wcl-agent\", service_name=\"claude-code\"}[$__interval])), \"agent_name\", \"main session\", \"agent_name\", \"\")",
          "legendFormat": "{{agent_name}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": 300000,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "maxDataPoints": 100,
      "interval": "5m",
      "id": 9,
      "type": "timeseries",
      "title": "Tokens by type",
      "description": "Tokens per time bucket by type.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(sum by (type) (increase(claude_code_token_usage{service_namespace=\"wcl-agent\", service_name=\"claude-code\"}[$__interval])), \"type\", \"Cache read\", \"type\", \"cacheRead\"), \"type\", \"Cache write\", \"type\", \"cacheCreation\"), \"type\", \"Input (uncached)\", \"type\", \"input\"), \"type\", \"Output\", \"type\", \"output\")",
          "legendFormat": "{{type}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": 300000,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Spend by agent (whole range)",
      "description": "Which agents cost the most in the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "label_replace(sum by (agent_name) (increase(claude_code_cost_usage{service_namespace=\"wcl-agent\", service_name=\"claude-code\"}[$__range])), \"agent_name\", \"main session\", \"agent_name\", \"\")",
          "legendFormat": "{{agent_name}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "manual",
        "minVizHeight": 22,
        "maxVizHeight": 34,
        "text": {
          "titleSize": 14,
          "valueSize": 16
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Tokens by model and type (whole range)",
      "description": "Token totals in the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(sum by (model, type) (increase(claude_code_token_usage{service_namespace=\"wcl-agent\", service_name=\"claude-code\"}[$__range])), \"type\", \"Cache read\", \"type\", \"cacheRead\"), \"type\", \"Cache write\", \"type\", \"cacheCreation\"), \"type\", \"Input (uncached)\", \"type\", \"input\"), \"type\", \"Output\", \"type\", \"output\")",
          "legendFormat": "{{type}} ({{model}})",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "manual",
        "minVizHeight": 22,
        "maxVizHeight": 34,
        "text": {
          "titleSize": 14,
          "valueSize": 16
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    }
  ],
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "wcl-agent"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ]
}
