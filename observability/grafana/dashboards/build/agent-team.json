{
  "uid": "wcl-agent-team",
  "title": "Claude Code: Agent Team",
  "description": "D2: cost and activity of the agent team by agent.name, model and board seat. Live panels query the cc:* recording rules; seat cost comes per sprint from teamstats.py. Cost is an estimate at list price.",
  "tags": [
    "wcl-agent",
    "build"
  ],
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Sprint ends",
        "enable": true,
        "iconColor": "rgba(255, 152, 48, 0.9)",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "expr": "max by (sprint) (team_sprint_points)",
        "step": "60s",
        "titleFormat": "Sprint {{sprint}} ends",
        "textFormat": "{{sprint}}: see Agent Team: Improvement",
        "tagKeys": "sprint",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "wcl-agent"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Agent Team: Improvement",
      "type": "link",
      "url": "/d/wcl-team-improvement",
      "keepTime": false,
      "includeVars": false,
      "targetBlank": false,
      "icon": "dashboard"
    },
    {
      "title": "Claude Code: Overview",
      "type": "link",
      "url": "/d/wcl-cc-overview",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Team spend (estimated, list price)",
      "description": "Claude Code's own cost estimate at API list prices. On a Max plan this is the list-price equivalent, not what you are billed.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum (sum_over_time(cc:cost_usd:rate5m{service_namespace=\"wcl-agent\"}[$__range])) * 60",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "noValue": "0",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sub-agent share of spend (estimated, list price)",
      "description": "Spend of named agents (sub-agents) / all spend over the range.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum (sum_over_time(cc:cost_usd:rate5m{service_namespace=\"wcl-agent\", agent_name!=\"\"}[$__range])) * 60 / sum (sum_over_time(cc:cost_usd:rate5m{service_namespace=\"wcl-agent\"}[$__range])) * 60",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "0",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Agent types active",
      "description": "Distinct agent.name values with spend in the range (main session excluded).",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "count(sum by (agent_name) (sum_over_time(cc:cost_usd:rate5m{service_namespace=\"wcl-agent\", agent_name!=\"\"}[$__range])) > 0)",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "Cache-read tokens / all tokens over the range.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum (sum_over_time(cc:tokens:rate5m{service_namespace=\"wcl-agent\", type=\"cacheRead\"}[$__range])) * 60 / sum (sum_over_time(cc:tokens:rate5m{service_namespace=\"wcl-agent\"}[$__range])) * 60",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "noValue": "0",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "maxDataPoints": 100,
      "interval": "5m",
      "id": 5,
      "type": "timeseries",
      "title": "Cost per agent.name (estimated, list price)",
      "description": "Estimated spend per time bucket by Claude Code agent type.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "label_replace(sum by (agent_name) (sum_over_time(cc:cost_usd:rate5m{service_namespace=\"wcl-agent\"}[$__interval])) * 60, \"agent_name\", \"main session\", \"agent_name\", \"\")",
          "legendFormat": "{{agent_name}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": 300000,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "maxDataPoints": 100,
      "interval": "5m",
      "id": 6,
      "type": "timeseries",
      "title": "Tokens per agent.name",
      "description": "Tokens per time bucket by agent type.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "label_replace(sum by (agent_name) (sum_over_time(cc:tokens:rate5m{service_namespace=\"wcl-agent\"}[$__interval])) * 60, \"agent_name\", \"main session\", \"agent_name\", \"\")",
          "legendFormat": "{{agent_name}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": 300000,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Cost by agent.name and model, whole range (estimated, list price)",
      "description": "Which model each agent type ran on, and what it cost. A model swap shows as a second bar for the same agent.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sort_desc(label_replace(sum by (agent_name, model) (sum_over_time(cc:cost_usd:rate5m{service_namespace=\"wcl-agent\"}[$__range])) * 60, \"agent_name\", \"main session\", \"agent_name\", \"\"))",
          "legendFormat": "{{agent_name}} / {{model}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Tokens per agent.name and type, whole range",
      "description": "Token mix per agent type.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sort_desc(label_replace(label_replace(label_replace(label_replace(label_replace(sum by (agent_name, type) (sum_over_time(cc:tokens:rate5m{service_namespace=\"wcl-agent\"}[$__range])) * 60, \"agent_name\", \"main session\", \"agent_name\", \"\"), \"type\", \"Cache read\", \"type\", \"cacheRead\"), \"type\", \"Cache write\", \"type\", \"cacheCreation\"), \"type\", \"Input (uncached)\", \"type\", \"input\"), \"type\", \"Output\", \"type\", \"output\"))",
          "legendFormat": "{{agent_name}} {{type}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Per board seat (per sprint, pushed at wrap-up)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Cost per board seat and sprint (estimated, list price, at Opus 5.5 rates)",
      "description": "Live metrics carry no seat (every developer is agent.name=developer). At each wrap-up .claude/team/teamstats.py attributes usage.txt's agents to the seat named in their label (product-owner -> po, main -> lead; QA sweeps and unnamed agents are 'unattributed') and prices the weighted tokens at claude-opus-5-5 list price: usage.txt has no model per agent.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (sprint, seat) (last_over_time(team_seat_cost_usd[$__range]))",
          "legendFormat": "{{seat}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "valueLabel": "seat"
          }
        },
        {
          "id": "merge",
          "options": {}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "sprint",
        "orientation": "vertical",
        "stacking": "normal",
        "showValue": "never",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Activity",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Board: hand-offs, blockers and questions (open a trace from trace_id)",
      "description": "Team board entries (feature 055). Each entry carries the posting agent's traceparent: expand a line and use 'View trace' to open its tool span in Tempo.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "queryType": "range",
          "expr": "{service_namespace=\"wcl-agent\", service_name=\"team-board\"} | kind=~\"handoff|blocker|question|merge\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Sub-agents completed",
      "description": "Claude Code's subagent_completed events: agent type, duration and tool uses per sub-agent run.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "queryType": "range",
          "expr": "{service_namespace=\"wcl-agent\", service_name=\"claude-code\"} | event_name=\"subagent_completed\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "Interactions (open one for its sub-agent tree)",
      "description": "Claude Code traces: one per prompt; sub-agent spans nest under the Agent tool span that started them.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 50,
          "tableType": "traces",
          "query": "{ resource.service.name = \"claude-code\" && resource.service.namespace = \"wcl-agent\" }"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}
