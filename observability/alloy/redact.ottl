set(attributes["access_token"], SHA256(attributes["access_token"])) where attributes["access_token"] != nil
set(attributes["refresh_token"], SHA256(attributes["refresh_token"])) where attributes["refresh_token"] != nil
set(attributes["client_secret"], SHA256(attributes["client_secret"])) where attributes["client_secret"] != nil
set(attributes["authorization"], SHA256(attributes["authorization"])) where attributes["authorization"] != nil
set(attributes["api_key"], SHA256(attributes["api_key"])) where attributes["api_key"] != nil
set(attributes["password"], SHA256(attributes["password"])) where attributes["password"] != nil
replace_all_patterns(attributes, "value", "eyJ[A-Za-z0-9_-]{4,}\\.[A-Za-z0-9_-]{4,}\\.[A-Za-z0-9_-]+", "<jwt:redacted>")
replace_all_patterns(attributes, "value", "(?i)(bearer\\s+)[A-Za-z0-9._~+/=-]+", "${1}<redacted>")
replace_all_patterns(attributes, "value", "sk-[A-Za-z0-9_-]{16,}", "sk-<redacted>")
replace_all_patterns(attributes, "value", "AIza[0-9A-Za-z_-]{30,}", "AIza<redacted>")
replace_all_patterns(attributes, "value", "(postgres(?:ql)?(?:\\+[a-z0-9]+)?://[^:/@\\s]+:)[^@\\s]+@", "${1}<redacted>@")
