# Warcraft Logs API client (create one at https://www.warcraftlogs.com/api/clients/)
WCL_CLIENT_ID=your_wcl_client_id
WCL_CLIENT_SECRET=your_wcl_client_secret
# Blizzard Game Data API (https://community.developer.battle.net/documentation/guides/getting-started)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# LLM provider (feature 032): who serves every model call. Switch with this one line and a
# backend restart.
#   vertex (default): Gemini, and Claude through Vertex's Model Garden (the block below).
#   anthropic: Claude through the Anthropic API with ANTHROPIC_API_KEY. Gemini isn't offered,
#     the model roles below fall back to Claude defaults, and the chat agent, greeting and
#     model discovery don't need Google ADC (without an ADC file, set GCP_ADC_FILE=/dev/null).
#     Until feature 035, suggestions, titles, reports and guides still call Gemini on Vertex.
WCL_LLM_PROVIDER=vertex
# Secret: never commit it. Read only under anthropic; never logged or returned by the API.
ANTHROPIC_API_KEY=

# Gemini via Vertex AI, authenticated with gcloud Application Default Credentials.
# Run once:  gcloud auth application-default login
# Docker Compose mounts your ADC file into the backend container (read-only).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# The general region. Model calls do NOT use it: they run at WCL_MODEL_LOCATION below,
# because europe-west1 serves only Gemini 2.5 and no Claude (checked 2026-10-18).
GOOGLE_CLOUD_LOCATION=europe-west1
# Where every model call runs: chat, web search, guides, reports, greeting, suggestions
# and the discovery probes. `global` serves every current Gemini and Claude model.
WCL_MODEL_LOCATION=global

# Model selection shown in the UI dropdown (feature 016).
# catalog (default): at startup the app lists Vertex's Model Garden catalog, sorts the
# models into classes, and probes the newest few versions of each class with a
# one-token request that carries a tool declaration. It keeps the newest `count` that
# answer per class, in the order given. A preview model outranks an older GA one. The
# result is shared through Redis for 6 h (WCL_CACHE_TTL_MODEL_CATALOG); delete the
# `ext:models:*` keys and restart to re-discover sooner.
# static: probe only WCL_GEMINI_MODELS / WCL_ANTHROPIC_MODELS (the pre-016 behaviour).
WCL_MODEL_DISCOVERY=catalog
WCL_GEMINI_CLASSES=pro:2,flash:2,flash-lite:2
# Claude needs a per-class quota increase in the Cloud console; until then every Claude
# class logs "no quota (429)" at startup and none is offered. Empty = no Claude.
WCL_ANTHROPIC_CLASSES=haiku:1,sonnet:1,opus:1
# WCL_CACHE_TTL_MODEL_CATALOG=21600
#
# Static-mode candidates, also probed when the catalog can't be listed (comma-separated).
# Gemini ids pass through to Vertex; Claude ids run on the active provider, in its id form
# (claude-x@YYYYMMDD on Vertex, claude-x-YYYYMMDD on the API; either is accepted). Under
# anthropic, catalog mode lists the Anthropic Models API (Claude only, per
# WCL_ANTHROPIC_CLASSES) and these lists are its fallback and, in static mode, the whole
# set (Gemini ids ignored); an empty WCL_ANTHROPIC_MODELS then probes the Claude role defaults.
WCL_GEMINI_MODELS=gemini-3.6-flash,gemini-3.1-pro-preview
WCL_ANTHROPIC_MODELS=claude-sonnet-4@20250514
# Degraded list, served with a notice if no model passes its probe.
WCL_MODELS=gemini-3.6-flash,gemini-3.1-pro-preview
# Model roles (feature 032). Each has a default per provider; a value set here wins only if
# the active provider serves it (a Gemini id under anthropic is ignored with a warning).
#   role                  vertex default           anthropic default
#   WCL_DEFAULT_MODEL      gemini-3.6-flash         claude-sonnet-5-5
#   WCL_REPORT_MODEL       gemini-3.6-flash         claude-sonnet-5-5
#   WCL_GUIDE_MODEL        gemini-3.7-flash         claude-sonnet-5-5
#   WCL_GUIDE_REVIEW_MODEL gemini-3.1-pro-preview   claude-opus-5-5
#   WCL_SUGGEST_MODEL      gemini-3.6-flash         claude-haiku-5-5   (suggestions, titles)
#   WCL_GREETING_MODEL     gemini-3.5-flash-lite    claude-haiku-5-5
# WCL_SUGGEST_MODEL=gemini-3.6-flash
# WCL_GREETING_MODEL=gemini-3.5-flash-lite
# Preferred default; if it isn't served, the newest flash model is the default.
WCL_DEFAULT_MODEL=gemini-3.6-flash

# Background spec-guide generation (US6). A web-search-capable model so guides
# reflect the current retail patch.
WCL_GUIDE_MODEL=gemini-3.6-flash

# Per-user cap on manual spec-guide generation (feature 008 / Class Guides tab). Bounds
# user-initiated generation so a burst can't cascade into WCL/model rate limits. Optional.
WCL_GUIDE_GENERATE_PER_MINUTE=10
# Per-user cap on recent-raid investigations (feature 052): each starts a conversation and a
# background pre-fetch of up to 11 WCL requests. Optional.
WCL_INVESTIGATE_PER_MINUTE=5
# Max background guide / guild-summary generations running at once (PERF-012).
WCL_GUIDE_MAX_CONCURRENCY=2
# Grounded guide pipeline (feature 015). The reviewer must be a different, stronger model.
# WCL_GUIDE_REVIEW_MODEL=gemini-3.1-pro-preview
# WCL_GUIDE_MAX_REVIEW_ROUNDS=3
# Coaching brief budgets in characters: one brief, and whole briefs inlined per chat turn.
# WCL_GUIDE_BRIEF_MAX_CHARS=6000
# WCL_GUIDE_PREAMBLE_BRIEFS_MAX_CHARS=12000
# Ranked players a Warcraft Logs data sheet needs before its numbers count as guidance.
# WCL_GUIDE_DATASHEET_MIN_SAMPLE=20
# Stale guides wanted within this many days regenerate at once; others when next opened.
# WCL_GUIDE_INUSE_DAYS=14
# Per-user cap on "Report an inaccuracy".
# WCL_GUIDE_REPORT_PER_MINUTE=5
# Fetch allowlisted third-party guide pages, and an optional talent-name JSON. Leave off
# until the maintainer has reviewed those sites' terms.
# WCL_GUIDE_RESEARCH_FETCH_ENABLED=false
# WCL_GUIDE_TALENT_NAMES_URL=
# Live build and hotfix sources.
# WOW_VERSION_URL=https://us.version.battle.net/v2/products/wow/versions
# WOW_NEWS_URL=https://worldofwarcraft.blizzard.com/en-us/news

# Findings-report synthesis (feature 007). A plain (non-web-search) model that turns a
# conversation/message into an analytic findings document for the PDF export.
WCL_REPORT_MODEL=gemini-3.6-flash

# Model rate-limit relief (feature 011). Retry rate-limited/overloaded model calls with
# exponential backoff: up to ATTEMPTS tries per request, delays from INITIAL_S doubling
# to MAX_S (+ jitter), never waiting more than BUDGET_S in total per request. ROUND_CAP
# is how many lookup rounds a turn may use before the agent is told to wrap up.
WCL_MODEL_RETRY_ATTEMPTS=5
WCL_MODEL_RETRY_INITIAL_S=2.0
WCL_MODEL_RETRY_MAX_S=30.0
WCL_MODEL_RETRY_BUDGET_S=90.0
WCL_TURN_ROUND_CAP=6

# Max Warcraft Logs requests in flight at once across the process. Tools are async and fan
# out inside a tool (PERF-001/002, feature 013); this one cap bounds the load on WCL.
WCL_MAX_CONCURRENCY=6
# WCL slots background work (guides, patch lookup, recent raids) may hold, so chat lookups
# never queue behind it (feature 013). Clamped to 1..WCL_MAX_CONCURRENCY-1.
# WCL_BACKGROUND_CONCURRENCY=2
# Upper bound in seconds for one WCL query, including the wait for a free slot.
# WCL_QUERY_TIMEOUT_S=75
# Welcome-page recent raids: minimum seconds between refreshes, and when a stuck
# refresh may be reclaimed.
# RECENT_RAIDS_REFRESH_MIN_S=900
# RECENT_RAIDS_STALE_S=300
# Model context (PERF-004): tool results older than this many turns (current turn included)
# are replaced by compact stubs in each model request when larger than the char threshold.
WCL_CONTEXT_KEEP_TURNS=2
WCL_CONTEXT_STUB_MIN_CHARS=1500
# Shared WCL cache in Redis (feature 014). Without REDIS_URL (or with
# WCL_CACHE_ENABLED=false) there is no cache and every lookup goes to Warcraft Logs.
# This URL is for host-side runs (CLI, tests); docker compose sets
# REDIS_URL=redis://redis:6379/0 for the backend container itself.
REDIS_URL=redis://localhost:6379/0
WCL_CACHE_ENABLED=true
# Per-family TTLs in seconds (defaults shown). Report families apply to finished reports;
# a report still being logged is cached for WCL_CACHE_UNFINISHED_TTL only. The OAuth
# token always follows its own expiry.
# WCL_CACHE_TTL_CHAR_ID=86400
# WCL_CACHE_TTL_CHAR_OVERVIEW=600
# WCL_CACHE_TTL_CHAR_REPORTS=300
# WCL_CACHE_TTL_REPORT_SUMMARY=86400
# WCL_CACHE_TTL_REPORT_PLAYER=86400
# WCL_CACHE_TTL_REPORT_PARTICIPANTS=86400
# WCL_CACHE_TTL_WORLD_ZONES=3600
# WCL_CACHE_UNFINISHED_TTL=120
# TTLs are stretched by a random 0..JITTER fraction so entries written together don't
# expire together.
# WCL_CACHE_JITTER=0.10
# Concurrent misses on one key: one loads, the others wait up to LOCK_WAIT_MS for it
# (callers in the same process simply share the load). LOCK_MS outlives the query timeout.
# WCL_CACHE_LOCK_MS=90000
# WCL_CACHE_LOCK_WAIT_MS=2000
# How long a "character not found" answer is remembered.
# WCL_NEG_CACHE_TTL=60
# Days the per-family hit/miss counters are kept (admin stats: /api/admin/cache-stats).
# WCL_METRICS_RETENTION_DAYS=35
# Every successful Warcraft Logs response is stored in the raw_fetches table by a
# background writer (feature 020). At most QUEUE_MAX responses / QUEUE_MB megabytes wait to
# be written; when full, new ones are dropped from storage (the chat is never slowed).
# WCL_FETCH_PERSIST_ENABLED=true
# WCL_FETCH_PERSIST_QUEUE_MAX=500
# WCL_FETCH_PERSIST_QUEUE_MB=64
# Knowledge base (feature 043): stored WCL data, published guides and finished chats become
# chunks in a background queue and are embedded with Vertex (the GCP config above; works while
# chat runs on Anthropic too). Without embeddings chunks stay keyword-searchable; rows still
# missing a vector are retried every SWEEP_S seconds. REQUEST_BATCH texts go in one Vertex
# request. PRICE_PER_MTOK (USD per 1M tokens) only feeds the backfill's cost estimate:
#   uv run python -m backend.cli.kb_backfill            # counts + cost, writes nothing
#   uv run python -m backend.cli.kb_backfill --confirm  # write + embed; safe to rerun
# KB_INDEX_ENABLED=true
# KB_EMBED_ENABLED=true
# KB_EMBED_MODEL=gemini-embedding-001
# KB_INDEX_QUEUE_MAX=1000
# KB_EMBED_BATCH=32
# KB_EMBED_REQUEST_BATCH=1
# KB_EMBED_SWEEP_S=600
# KB_EMBED_PRICE_PER_MTOK=0.15

# DB connection pool (PERF-006), shared by the app and the ADK session store.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10

# PostgreSQL (feature 006 multi-tenancy uses TWO roles).
#   POSTGRES_* = the OWNER/superuser role: owns tables, runs Alembic migrations.
#   APP_DB_*   = the non-privileged RUNTIME role the app connects as (created by
#                postgres-init on first DB init; NO BYPASSRLS so row-level security
#                actually constrains it — research R4).
POSTGRES_USER=wcl
POSTGRES_PASSWORD=wcl
POSTGRES_DB=wcl
APP_DB_USER=wcl_app
APP_DB_PASSWORD=wcl_app
# For running the backend OUTSIDE docker (bare metal), point at localhost.
#   DATABASE_URL       = runtime role (RLS applies) — used by the app.
#   DATABASE_OWNER_URL = owner role — used ONLY by Alembic (`uv run alembic upgrade head`).
# In simple single-role dev you may leave DATABASE_OWNER_URL blank (falls back to
# DATABASE_URL), but RLS is only meaningfully tested when the two roles differ.
DATABASE_URL=postgresql+asyncpg://wcl_app:wcl_app@localhost:5432/wcl
DATABASE_OWNER_URL=postgresql+asyncpg://wcl:wcl@localhost:5432/wcl

# --- Auth / session / tenancy (feature 006) ---------------------------------
# Canonical site origin used to build invite/reset links (never the inbound Host
# header) and to validate WS/CSRF Origin. No trailing slash.
SITE_URL=http://localhost:5173
# Session cookie name + Secure flag. The default name uses the __Host- prefix, which
# REQUIRES Secure=true + HTTPS. Over plain HTTP, Chrome/Firefox accept it on localhost but
# Safari (and others) silently drop it → you get logged out (GET /api/auth/me → 401). For
# plain-HTTP local dev on any browser, change BOTH: set Secure=false AND drop the __Host-
# prefix from the name (a non-Secure __Host- cookie is rejected by every browser):
#   SESSION_COOKIE_SECURE=false
#   SESSION_COOKIE_NAME=session
# In any HTTPS/production deployment keep Secure=true and the __Host- name.
SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_NAME=__Host-session   # uncomment + set to `session` for plain-HTTP dev
# Server secret for HMAC-deriving per-session CSRF tokens. MUST be a strong random value
# in production (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# The backend refuses to start on this dev value (or an empty, under-32-character or
# "change-me" key) unless SITE_URL is http(s)://localhost or 127.0.0.1, and warns at startup
# while such a key (or the built-in DATABASE_URL) is in use (feature 052).
SECRET_KEY=dev-insecure-change-me
# Reverse proxies whose X-Forwarded-For is trusted when rate-limiting logins and the
# public token endpoints per client: comma-separated IPs or CIDRs. List the exact proxy
# address (e.g. the nginx container's fixed IP) or a network that holds nothing but your
# proxies. A broad range such as 172.16.0.0/12 also covers the Docker gateway and sibling
# containers, which could then pick their own rate-limit key. Empty (the default) trusts
# no header, so behind a proxy every client shares the proxy's bucket.
# TRUSTED_PROXIES=

# Founder (first platform admin) credentials. Set these so `uv run python -m
# backend.cli.init_db` can migrate + create the founder + migrate in one non-interactive,
# idempotent command (leave unset to be prompted). Password must meet the policy (15+ chars).
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-long-passphrase

# --- Telemetry (feature 054) -------------------------------------------------------------
# Backend traces, logs and metrics go to Alloy over OTLP http/protobuf, only when this is
# set (unset = no telemetry at all). docker compose sets http://alloy:4318 for the backend;
# a local backend uses the host port: http://localhost:4318. Alloy being down never blocks
# the app (data is dropped; the flush at shutdown waits a few seconds at most).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# dev | ci | prod. ONLY dev exports prompts, answers and tool input/output (7-day content
# stream); anything else, unset included, forces ADK's content lockdown. Secrets are masked
# in every environment.
# WCL_ENVIRONMENT=dev
# service.version on every signal; default: `git rev-parse --short HEAD`, else "unknown".
# WCL_GIT_SHA=
# GRAFANA_ADMIN_PASSWORD=  # Grafana admin login (observability profile); unset = no admin login, anonymous visitors are Viewers

# --- Data-store telemetry (feature 058) ---------------------------------------------------
# The monitoring role Alloy's Postgres exporter logs in as (member of pg_monitor only), created
# by migration 0022 only when PG_MONITOR_PASSWORD is set: there is no default. Letters and
# digits only (it goes into the exporter's connection URL). Unset = no Postgres metrics.
# PG_MONITOR_USER=wcl_monitor
# PG_MONITOR_PASSWORD=
# Host ports of db and redis (default 5432 and 6379; the observability test stacks move them).
# DB_PORT=5432
# REDIS_PORT=6379
